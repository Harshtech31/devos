{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devos.dev/schemas/v0/workspace.schema.json",
  "title": "Workspace",
  "description": "Canonical Workspace contract per DEVOS-SPEC-020. The Workspace is the root aggregate and single Aggregate Root: it owns exactly one Project plus one or more Profiles and all supporting objects per DEVOS-SPEC-015.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "project", "profiles", "manifest"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable Workspace identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable Workspace name."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace schema or manifest version."
    },
    "project": {
      "$ref": "project.schema.json",
      "description": "The single Project owned by the Workspace."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "profile.schema.json" },
      "description": "One or more Profiles, each owning exactly one Environment."
    },
    "manifest": {
      "$ref": "manifest.schema.json",
      "description": "The declarative Workspace definition per DEVOS-SPEC-029."
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "connection.schema.json" }
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "provider.schema.json" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "plugin.schema.json" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "template.schema.json" }
    },
    "secrets": {
      "type": "array",
      "items": { "$ref": "secret.schema.json" },
      "description": "Secret references and metadata only; raw values never appear anywhere per DEVOS-SPEC-028."
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    },
    "documentation": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentationEntry" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tasks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" },
          "description": "One or more atomic executable operations per the Workflow owns Task relationship of DEVOS-SPEC-015."
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "documentationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
