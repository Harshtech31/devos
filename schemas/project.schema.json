{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devos.dev/schemas/v0/project.schema.json",
  "title": "Project",
  "description": "Canonical Project contract per DEVOS-SPEC-021. A Project represents the single software system managed by one Workspace and cannot exist outside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable Project identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable Project name."
    },
    "description": {
      "type": "string",
      "description": "Short explanation of the managed system."
    },
    "version": {
      "type": "string",
      "description": "Declared Project version."
    },
    "metadata": {
      "type": "object",
      "description": "Additional non-normative key/value information.",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
